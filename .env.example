# The Styliste environment variable names — placeholders only.
#
# Local development: copy the required names into an ignored local environment
# file or provide them with --dart-define/your local Supabase tooling.
# Staging and production: keep values in the approved CI/deployment secret
# store. Never copy staging or production values into a repository file.

# Public mobile configuration. These are the only backend values approved for
# inclusion in the Flutter client.
APP_ENV=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=public-client-key-placeholder

# Server-only Edge Function/deployment configuration. Never pass these values
# to Flutter, include them in an APK/IPA, or commit a populated copy.
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder
SUPABASE_DB_PASSWORD=server-only-placeholder
CRON_INVOKE_SECRET=server-only-placeholder
ECLIPSE_EVENT_TICK_SECRET=server-only-placeholder

# Conditional paid-entitlement configuration. Leave unprovisioned until that
# feature wave is separately approved and tested in a purchase sandbox.
APPLE_SHARED_SECRET=server-only-placeholder
APPLE_BUNDLE_ID=app-bundle-id-placeholder
GOOGLE_SERVICE_ACCOUNT_KEY=server-only-json-placeholder
GOOGLE_PACKAGE_NAME=app-package-name-placeholder

# Firebase variables are intentionally omitted. Firebase is not part of the
# approved stack recorded in PROJECT_RULES.md.
